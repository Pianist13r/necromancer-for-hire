# ── Вид скелета и клипы анимации → CfgAnim (cfg_anim.gd), владелец — трек анимации ──


## Экранный размер холста спрайта: рисуем весь холст мастера так, чтобы высота его
## КОНТЕНТА оказалась ровно ANCHOR_PX * visual.
static func canvas_px(vis: Dictionary) -> float:
	return ANCHOR_PX * float(vis["visual"]) / float(vis["frac"])


## Множитель scale для Sprite2D с мастером MASTER_PX.
static func sprite_scale(vis: Dictionary) -> Vector2:
	var s := canvas_px(vis) / MASTER_PX
	return Vector2(s, s)
