class_name LessonsCfg
extends RefCounted
##
## Числа уроков карт (кампания v20, docs/legion/CAMPAIGN_V20.md, D-0926-46): движок —
## legion_tutorial.gd, сами уроки — поле `lessons` в JSON карты. Отдельный файл, а не
## legion_cfg.gd: тот у потолка gdlint (так же живут figure_cfg.gd и fx/cfg_*.gd).
##

## Урок посреди боя прячется, если его условия нет столько секунд подряд (D-0927-54): Юриста
## добили без Ку, прогиб ушёл, бойцов забрал договор, способность в откате. Урок не зачтён и
## встанет снова, когда условие вернётся (флаг не ставится). Запас — чтобы плашка не мигала,
## когда прогиб качается у порога; было 4 с только у урока Ку по Юристу.
const WITHDRAW_T := 1.5
## Спрятанный урок встаёт снова не раньше, чем через столько секунд: без этой паузы прогиб,
## перескакивающий порог раз в ~1,5 с, гасил плашку на 2 кадра и тут же проявлял — глаз видит
## мигание (проверяющий 27.09, зонд vlt/zz_probe).
const REAPPEAR_T := 2.0
## Пауза REAPPEAR_T — только у уроков, чьё условие качается само: прогиб, откат, простой
## бойцов. Уроки по врагу (Юрист, нотариус, щитоносец, призрак, элитный) встают сразу: новый враг
## — новый повод, а пауза пропускала вперёд следующий урок лестницы (Ку по Юристу → срыв по
## оглушённым).
const REAPPEAR_KINDS: Array[StringName] = [&"spring", &"hero_e", &"hero_w", &"rally"]
## B-081: урок посреди боя глушит все советы-надписи только первые ADVICE_QUIET_T секунд (плашку
## прочесть); дальше молчат лишь советы, спорящие с уроком или говорящие то же (MUTES: вид урока →
## типы советов LegionIntuit). Раньше непройденный урок глушил советы до конца боя («пружину»
## проигнорировали 120 с — советов не было вовсе). Уроки начала боя (держат волну) глушат всё.
const ADVICE_QUIET_T := 6.0
const MUTES := {
	&"spring": [&"spring", &"e"], &"hero_e": [&"e", &"spring"], &"hero_q": [&"q"],
	&"hero_w": [&"w"], &"stun_hit": [&"q", &"gold"], &"perfect": [&"gold"],
	&"aim": [&"gold"], &"rally": [],
}
## Урок «Сбор»: столько свободных бойцов, простаивающих не меньше LegionCfg.IDLE_NOTICE_TIME
## (тот же порог, что значок простоя над головой), должно стоять в радиусе «Сбора» от одного из
## них. Меньше трёх — «Сбор» почти ничего не меняет, да и один-два свободных — обычная
## перебежка между местами; три — штатная бригада (RALLY_SPARE), ради неё Эр уже стоит нажать.
const RALLY_MIN := 3
## Триггер `pressed`: участок прогнут хотя бы на эту долю прорыва — та же «пружина», за которую
## мир даёт бонус выпуску (LegionCfg.SPRING_MIN): урок зовёт ровно тогда, когда срыв выгоден.
const PRESS_TRIGGER := LegionCfg.SPRING_MIN
## Бот урока «Точно!» срывает участок, когда враг ближе этого к его середине (px).
const BOT_PERFECT_R := 110.0
## Шаблон фигуры для метки и бота: шаг точек штриха (как у мыши, POINT_STEP ~6 px).
const FIG_STEP := 6.0
## Кольцо-шаблон не замкнуто на столько (рад): зазор замыкает распознавание, как у руки.
const RING_GAP := 0.18
## Восьмёрка-шаблон: полуширина петли — эта доля от полувысоты (лемниската Жероно, та же
## форма, что «8 вертикальная» в корпусе legion_runes_test).
const EIGHT_WIDTH := 0.41
## KB-07: действие для составной реплики урока (legion_tutorial_voice.gd). Старая запись с
## фиксированной клавишей по-прежнему проверяется voice_muted; проигрыватель выбирает новую
## фразу и имя текущей клавиши. Новую реплику с клавишей — сюда (линтер в
## tests/legion_keys_text_test.gd падает, если реплика называет клавишу, а строки здесь нет).
const VOICE_KEYS := {
	&"lg_tut_4": [&"cast_q"], &"lg_tut_lawyer": [&"cast_q"], &"lg_tut_hero_w": [&"cast_w"],
	&"lg_tut_hero_e": [&"cast_e"], &"lg_tut_rally": [&"rally"], &"lg_tut_aim": [&"aim_contract"],
}
