## подходил к центру на 75 px (verify-gold e7f7790). Запас покрывает отброс, а не только шаг.
const LURE_MARGIN_SHAPE := 90.0
const GOLD_W := 5.0
const GOLD_GLOW_W := 12.0
const GOLD_PULSE_RATE := 7.0
