class_name CfgLines
extends RefCounted
##
## Числа вида линий-договоров (ContractField): слои свечения, течение, рождение, растворение.
## Чистый вид: симуляцию не трогают, время — часы поля (ContractField.now = часы мира, поэтому
## пауза и «Отсрочка» замедляют и течение). Цвет — не здесь: он у вида (LegionCfg.UNIT_KINDS).
## Отдельный файл, а не CfgFx: слой эффектов правят параллельно, линии — своё.
##
## Вкус (Игорь 26.09: «линии должны быть красивее»): мягкое многослойное свечение, живое течение
## к стрелке выпуска, вспышка при заключении и растворение вместо исчезновения — но линия
## остаётся тонкой и не закрывает бойцов, а мигание срока читается как прежде.
##

# ── слои под бойцами (полная графика), от широкого к узкому ────────────────
## Тень-подложка: отделяет светящуюся линию от светлой земли (плиты, песок, болото).
const SHADOW_W := 10.0
const SHADOW := Color(0.04, 0.03, 0.06, 0.28)
## Ореол — широкий и едва заметный: «аура» договора; дышит (BREATH_*), фаза своя у договора.
const HALO_W := 26.0
const HALO_A := 0.1
const GLOW_W := 13.0
const GLOW_A := 0.26
const BODY_W := 5.5
const BODY_A := 0.85
const CORE_W := 2.4
const CORE_A := 0.95
const BREATH_RATE := 1.7            ## рад/с
const BREATH := 0.4                 ## доля альфы ореола, которая «дышит»

# ── течение (поверх бойцов): светлые штрихи бегут от краёв участка к середине ─
## Туда, где кольцо срока и стрелка выпуска: энергия собирается в печать и уходит по стрелке.
## На мигающем (последние секунды) и прогнутом участке течения нет — договор «иссякает».
const FLOW_SPEED := 24.0            ## px/с
const FLOW_GAP := 16.0              ## между штрихами на половине участка
## Штрих толще сердцевины контура и белее её: иначе светлое по светлому не видно (кадры 26.09).
const FLOW_LEN := 7.0
const FLOW_W := 3.4
const FLOW_WHITE := 0.6
const FLOW_A := 0.9

# ── рождение: по новой линии пробегает раскалённая голова, свечение вспыхивает и оседает ─
const BIRTH_T := 0.5
const BIRTH_SWELL := 0.8            ## ореол и свечение шире в первый миг на эту долю
const BIRTH_HEAD_R := 5.0
const BIRTH_HALO_R := 15.0
const BIRTH_HALO_A := 0.4

# ── растворение участка (растаял, выпущен, договор снят) ───────────────────
const FADE_T := 0.65
const FADE_RISE := 10.0             ## линия всплывает, пока бледнеет
const FADE_SPREAD := 0.6            ## свечение расплывается шире на эту долю
const FADE_EMBERS := 7              ## искр на участок
const FADE_EMBER_RISE := Vector2(16.0, 34.0)
const FADE_EMBER_LEN := 4.0
const FADE_EMBER_W := 2.0
const FADE_EMBER_SWAY := 3.0
## Потолок одновременно растворяющихся участков: массовое таяние не должно копить хвост.
const FADE_CAP := 64

# ── продление (подрисовка): вспышка по продлённым участкам ─────────────────
const RENEW_T := 0.45
const RENEW_W := 11.0
const RENEW_A := 0.55

# ── перо черновика ──────────────────────────────────────────────────────────
const PEN_R := 3.5
const PEN_HALO_R := 11.0
const PEN_HALO_A := 0.35
const PEN_PULSE_RATE := 9.0
