static func apply(map: Dictionary, card: Dictionary, rng: RandomNumberGenerator) -> void:
	var arch := String(card["archetype"])
	var biome := String(card["biome"])
	var quirks: Array = card.get("quirks", [])
	var pool: Array = TITLES.get(arch, ["Объект"])
	var title := _fill(String(pool[rng.randi_range(0, pool.size() - 1)]), biome, rng)
	if bool(card.get("boss", false)):
		title = title + " особой важности" if rng.randf() < 0.5 else "Объект особой важности"
	map["title"] = title
	var main := ""
	for q: String in quirks:
		if q != "center" or main == "":
			main = q
	if bool(card.get("boss", false)):
		main = "boss"
	var sub := String(SUBTITLES.get(main, ""))
	if main == "roster":
		sub = String(ROSTER_SUB.get(String(card.get("roster", "")), "Особый состав"))
	map["subtitle"] = sub
	var hint := String(ARCH_HINT.get(arch, ""))
	var q_hint := ""
	if main == "roster":
		q_hint = String(ROSTER_HINT.get(String(card.get("roster", "")), ""))
	elif main == "quiet_road" and map["procgen"].has("quiet"):
		q_hint = String(QUIRK_HINT["quiet_road"]) % int(map["procgen"]["quiet"]["from_wave"])
	else:
		q_hint = String(QUIRK_HINT.get(main, ""))
	map["hint"] = (q_hint + " " + hint).strip_edges() if q_hint != "" else hint


static func _fill(t: String, biome: String, rng: RandomNumberGenerator) -> String:
	var g: Array = GEN.get(biome, ["объекта"])
	var p: Array = PLACE.get(biome, ["на объекте"])
	return t.replace("{gen}", String(g[rng.randi_range(0, g.size() - 1)])) \
		.replace("{place}", String(p[rng.randi_range(0, p.size() - 1)]))
