class_name FigureCfg
extends RefCounted
##
## Числа фигур договора «Двойная смена» (восьмёрка), «Обряд» (треугольник) и «Каре» (квадрат) —
## отдельно от legion_cfg.gd: тот упёрся в потолок gdlint (так же живут fx/cfg_fx.gd и
## fx/cfg_lines.gd). Пороги распознавания — в contract_shape.gd рядом с геометрией, здесь только
## игра.
##

# ── Длина ─────────────────────────────────────────────────────────────────────
## Предел длины ФИГУРЫ (кольцо, восьмёрка, треугольник, квадрат), px. У линии предел прежний —
## LINE_MAX 480: строй фигуры в 480 px стоит кучей и не читается. Цена — та же мана за пиксель,
## поэтому большая фигура дорога сама собой (720 px подрядом — 86 маны из 100). Штрих-не-фигура
## длиннее LINE_MAX обрезается до LINE_MAX, хвост возвращается маной.
const FIG_LEN_MAX := 720.0

# ── Восьмёрка — «Двойная смена» ───────────────────────────────────────────────
const EIGHT_LABEL := "Двойная смена"
const EIGHT_COLOR := Color(1.0, 0.55, 0.85)
## Пока восьмёрка держится, бойцы в её строю бьют в 1,5 раза чаще: откат удара × 1/1,5.
const EIGHT_PERIOD_MULT := 1.0 / 1.5
## Натиск «крест-накрест» кончается за центром чужой петли не дальше этого, px.
const EIGHT_OVERRUN := 24.0
## «Сверхурочные»: восьмёрка растаяла сама и в миг таяния занято не меньше этой доли мест.
const OVERTIME_FILL := 0.6
## Пауза до второго натиска, с боя. Кто к её концу ещё бежит первый натиск, срывается сразу,
## как добежит, но не позже OVERTIME_WAIT после паузы (натиск длится не больше CHARGE_TIME 2,5 с).
const OVERTIME_DELAY := 1.2
const OVERTIME_WAIT := 2.0
const OVERTIME_LABEL := "Сверхурочные!"
const CROSS_LABEL := "Крест-накрест!"
## Надписи над фигурой (совет «сорви: «Обряд!»», «золотой — щёлкни», имя фигуры при рождении)
## встают выше голов верхнего ряда: место строя + столько px (боец ~40 px ростом над точкой места
## и запас). Кадры 02.10: совет треугольника висел у центра поперёк толпы.
const CROWD_HEAD := 48.0

# ── Треугольник — «Обряд» (D-1002-03: вместо звезды, условия мягче) ──────────
const TRI_LABEL := "Обряд"
const TRI_COLOR := Color(0.78, 0.52, 1.0)
## Обряд: треугольник сорван любым способом (самотаяние, ПКМ, рогатка, Таб), и в этот миг
## занято не меньше этой доли мест. Потери строя его не срывают — просто убавляют долю.
## Было у звезды 0.7 и «без потерь, только самотаяние» — за уровень почти не набиралось.
const RITE_FILL := 0.5
## Радиус удара — от центра до вершин треугольника × это (удар накрывает фигуру и чуть шире).
const RITE_R_FRAC := 1.15
const RITE_R_MIN := 90.0
## Урон удара в центре (зомби 30 хп, чиновник ~60) и оглушение (босс — × Q_STUN_BOSS_MULT).
const RITE_DMG := 45.0
const RITE_STUN := 2.5
## Свежих трупов в радиусе встаёт внештатниками (LegionHero.raise, как Дубль-вэ).
const RITE_RAISE_MAX := 5
## Участники сильнее: урон × RITE_BUFF_MULT на RITE_BUFF_T секунд боя.
const RITE_BUFF_MULT := 1.6
const RITE_BUFF_T := 6.0
## Импакт: стоп-кадр мира, тряска, длительность вспышки треугольника (реальные мс).
const RITE_HITSTOP := 0.16
const RITE_SHAKE := 14.0
const RITE_SHAKE_T := 0.45
const RITE_FX_MS := 1400.0
const RITE_LABEL := "Обряд!"
## Крупная надпись обряда, кегль (обычные всплывашки — 30).
const RITE_LABEL_SIZE := 56
## Натиск участников после обряда — к центру (добить оглушённых), не дальше центра + это.
const RITE_OVERRUN := 20.0

# ── Квадрат — «Каре» (D-1002-03: оборона) ────────────────────────────────────
const SQUARE_LABEL := "Каре"
## Оливково-жёлтый: не путается с видами бойцов (оранжевый, синий, мятный), кольцом (голубой),
## восьмёркой (розовый) и треугольником (фиолетовый).
const SQUARE_COLOR := Color(0.82, 0.92, 0.38)
## Боец в строю квадрата получает урон × это (поверх брони вида спереди).
const SQUARE_DMG_MULT := 0.6
## Квадрат тает во столько раз дольше обычного срока (LegionCfg.SEG_TTL).
const SQUARE_TTL_MULT := 1.5

## Всплывашка рождения треугольника (ContractField._on_figure_made).
const RITE_BEGUN_LABEL := "Обряд начат — набери строй"
